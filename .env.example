# ============================================================
# VITA-BAND AI: BACKEND PRODUCTION ENVIRONMENT VARIABLES
# ============================================================

# Network binding (0.0.0.0 binds to all network interfaces in production)
HOST=0.0.0.0
PORT=8000

# Project Metadata
PROJECT_NAME="VITA-BAND AI"
VERSION="1.0.0"
DEBUG=false

# Operation Mode: DEMO (simulated real-time sensor stream) or HARDWARE (ESP32 telemetry)
OPERATION_MODE=DEMO

# CORS Allowed Origins
# Comma-separated list of allowed frontend domains.
# Example for production: CORS_ORIGINS=https://your-site.netlify.app,http://localhost:3000
# Use "*" for public access during hackathon demonstrations:
CORS_ORIGINS="*"

# Emergency Contact Configuration (Early-Warning Dispatch)
PRIMARY_EMERGENCY_CONTACT="+91 9876543210"
EMERGENCY_COUNTDOWN_SEC=15

# Storage
DATABASE_PATH="vita_band.db"

# Simulation Parameters
DEFAULT_SIMULATION_INTERVAL_SEC=0.5
SIMULATION_NOISE_LEVEL=0.05
