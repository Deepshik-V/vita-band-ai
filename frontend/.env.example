# ============================================================
# VITA-BAND AI: FRONTEND (NETLIFY) ENVIRONMENT VARIABLES
# ============================================================

# Public REST API URL of the deployed FastAPI Backend (NO trailing slash)
# Example: https://vita-band-ai-backend.onrender.com
VITE_API_URL=https://your-backend-service.onrender.com

# Public WebSocket URL of the deployed FastAPI Backend
# (Optional: If omitted, VITE_API_URL is automatically converted to wss://)
# Example: wss://vita-band-ai-backend.onrender.com/ws/health-stream
VITE_WS_URL=wss://your-backend-service.onrender.com/ws/health-stream
